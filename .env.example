# ==========================================
# SportsHub Environment Blueprint
# ==========================================

# Web Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dedicated SportsHub Supabase Project (Public / Client-Safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mobile Expo Supabase (Public / Client-Safe - mirrors Web public keys)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Server-Only Secret (NEVER expose to browser/client/mobile)
SUPABASE_SERVICE_ROLE_KEY=

# Media Storage (Cloudinary - Server Only Secret)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Maps & Geolocation
NEXT_PUBLIC_MAP_PROVIDER=
NEXT_PUBLIC_MAPS_API_KEY=

# Regional Defaults
DEFAULT_CURRENCY=LKR
DEFAULT_TIMEZONE=Asia/Colombo
